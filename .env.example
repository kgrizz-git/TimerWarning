# Local SonarQube Community Build. Copy to .env. .env is gitignored.
# scripts/sonar_scan.sh reads SONAR_TOKEN from the environment first, then
# from this file. It parses the file and never prints the token.
# An exported value wins. See dev-docs/development/sonarqube.md.
SONAR_TOKEN=
# Optional. Defaults to http://localhost:9000 when unset.
SONAR_HOST_URL=http://localhost:9000
