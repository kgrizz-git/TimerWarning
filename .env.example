# Local SonarQube Community Build. Copy to .env, then: chmod 600 .env
# .env is gitignored. scripts/sonar_scan.sh reads SONAR_TOKEN from the
# environment first, then from this file. It parses the file and never prints
# the token. An exported value wins. A leading "export " and a trailing
# " # comment" are accepted. See dev-docs/development/sonarqube.md.
SONAR_TOKEN=
# Optional. Defaults to http://localhost:9000 when unset.
# localhost and 127.0.0.1 are the same host for the freshness check.
SONAR_HOST_URL=http://127.0.0.1:9000
