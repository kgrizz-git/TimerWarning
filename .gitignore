# Virtual environments
venv/
env/
ENV/
.venv/

# Local secrets. SonarQube URL and token live in .env; never commit them.
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
dist/
*.egg-info/

# IDE files
.vscode/
.idea/
.cursor/hooks/state/
.githooks/enable-pre-push
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
tmp/
*.tmp
*.bak

# Local Git bundles and Cursor plan drafts. Already-tracked plans under
# .cursor/plans/ stay in history until they are archived and removed from the index.
*.bundle
.cursor/plans/
