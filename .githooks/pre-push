#!/bin/sh
#
# Local SonarQube freshness and BUG/VULNERABILITY ratchet when SONAR_TOKEN is set.
# This hook does not run sonar-scanner; run bash scripts/sonar_scan.sh first.
# Tier-A stays opt-in (INSTALL_PRE_PUSH=1). Disable Tier-A: rm .githooks/enable-pre-push
# Skip the Sonar checks (and the shell warning): SKIP_LOCAL_SONAR=1 git push
# Skip Python coverage: SKIP_PYTHON_COVERAGE=1 git push (CI does not honor that)
# Skip types and file sizes: SKIP_QUALITY_CHECKS=1 / SKIP_PYTHON_TYPES=1 (CI honors neither)
# Shell coverage runs with the opt-in Tier-A hook below, and always in CI.
#

set -e

ROOT="$(git rev-parse --show-toplevel)"

oids=""
if [ -t 0 ]; then
    "${ROOT}/scripts/check-sonar-freshness.sh"
    "${ROOT}/scripts/check_sonar_issues.py" --strict
else
    while read -r _local_ref local_sha _remote_ref _remote_sha; do
        case "${local_sha}" in
            ""|*[!0-9a-fA-F]*)
                continue
                ;;
        esac
        case "${local_sha}" in
            *[!0]*)
                # A branch tip is already a commit. An annotated tag object is not.
                commit_sha="$(git rev-parse --verify "${local_sha}^{commit}")" || {
                    echo "pre-push: ${local_sha} does not resolve to a commit." >&2
                    exit 1
                }
                oids="${oids} ${commit_sha}"
                ;;
        esac
    done
    # shellcheck disable=SC2086
    "${ROOT}/scripts/check-sonar-freshness.sh" --push ${oids}
    # shellcheck disable=SC2086
    "${ROOT}/scripts/check_sonar_issues.py" --strict --push ${oids}
fi

"${ROOT}/scripts/check-python-coverage.sh"
"${ROOT}/scripts/check-python-types.sh"
if [ "${SKIP_QUALITY_CHECKS:-0}" != "1" ] || [ "${CI:-}" = "true" ]; then
    "${ROOT}/scripts/check-file-sizes.sh" --strict
fi

# SonarCloud analyzes shell and the local Community Build does not. This warns about
# new "[" tests (S7688), the rule SonarCloud reports most. It never blocks a push.
if [ "${SKIP_LOCAL_SONAR:-0}" != "1" ]; then
    shell_rc=0
    "${ROOT}/scripts/check-sonar-shell-newcode.sh" || shell_rc=$?
    if [ "${shell_rc}" -eq 1 ]; then
        echo "pre-push: SonarCloud will likely flag the '[' tests above. The push is not blocked." >&2
    fi
fi

if [ ! -f "${ROOT}/.githooks/enable-pre-push" ]; then
    exit 0
fi

"${ROOT}/scripts/check-shell-coverage.sh"
exec "${ROOT}/scripts/pre-push-checks.sh"
