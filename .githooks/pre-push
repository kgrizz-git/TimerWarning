#!/bin/sh
#
# Local SonarQube freshness when SONAR_TOKEN is set. This hook does not run
# sonar-scanner; run bash scripts/sonar_scan.sh first.
# Tier-A stays opt-in (INSTALL_PRE_PUSH=1). Disable Tier-A: rm .githooks/enable-pre-push
# Skip the Sonar check: SKIP_LOCAL_SONAR=1 git push
#

set -e

ROOT="$(git rev-parse --show-toplevel)"

"${ROOT}/scripts/check-sonar-freshness.sh"

if [ ! -f "${ROOT}/.githooks/enable-pre-push" ]; then
    exit 0
fi

exec "${ROOT}/scripts/pre-push-checks.sh"
