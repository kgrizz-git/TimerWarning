#!/bin/sh
#
# Local SonarQube when .env is configured. Tier-A stays opt-in
# (install-git-hooks.sh INSTALL_PRE_PUSH=1). Disable Tier-A: rm .githooks/enable-pre-push
# Skip Sonar: SKIP_LOCAL_SONAR=1 git push
#

set -e

ROOT="$(git rev-parse --show-toplevel)"

"${ROOT}/scripts/run-local-sonar.sh"

if [ ! -f "${ROOT}/.githooks/enable-pre-push" ]; then
    exit 0
fi

exec "${ROOT}/scripts/pre-push-checks.sh"
