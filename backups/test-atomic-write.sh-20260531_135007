#!/bin/bash

###############################################################################
# Sleep Warning System - Atomic Write Test
#
# This script tests that write_config() uses atomic write pattern
# (temp file + rename) to prevent corruption if interrupted.
#
# Safety:
#   This test DOES NOT modify your real config file.
#   It uses test config files in tests/test-configs/atomic-write-tests/
#   The test backs up and restores CONFIG_FILE/CONFIG_DIR to ensure
#   the real config is never touched.
#
# Usage: ./tests/test-atomic-write.sh
###############################################################################

# Script configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB_DIR="${SCRIPT_DIR}/lib"
TEST_CONFIG_DIR="${SCRIPT_DIR}/tests/test-configs"
TEST_OUTPUT_DIR="${TEST_CONFIG_DIR}/atomic-write-tests"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Test counters
TESTS_RUN=0
TESTS_PASSED=0
TESTS_FAILED=0

# Backup original config paths (to restore after tests)
ORIGINAL_CONFIG_DIR=""
ORIGINAL_CONFIG_FILE=""

# Cleanup function
cleanup() {
    # Restore original config paths if they were backed up
    if [ -n "${ORIGINAL_CONFIG_DIR}" ]; then
        CONFIG_DIR="${ORIGINAL_CONFIG_DIR}"
    fi
    if [ -n "${ORIGINAL_CONFIG_FILE}" ]; then
        CONFIG_FILE="${ORIGINAL_CONFIG_FILE}"
    fi
    
    # Clean up test output directory
    rm -rf "${TEST_OUTPUT_DIR}"
}

# Setup test environment
setup() {
    # Create test output directory
    mkdir -p "${TEST_OUTPUT_DIR}"
    
    # Backup original config paths before sourcing modules
    # (config.sh will set these to real paths, so we save them first)
    ORIGINAL_CONFIG_DIR="${CONFIG_DIR:-}"
    ORIGINAL_CONFIG_FILE="${CONFIG_FILE:-}"
    
    # Set test config paths BEFORE sourcing modules
    # This ensures modules use test paths from the start
    CONFIG_DIR="${TEST_OUTPUT_DIR}"
    CONFIG_FILE="${TEST_OUTPUT_DIR}/config/sleep-warning.conf"
    
    # Create test config directory structure
    mkdir -p "${CONFIG_DIR}/config"
    
    # Source required modules
    # Note: config.sh will override CONFIG_FILE, so we'll restore it after sourcing
    source "${LIB_DIR}/configure-core.sh" || exit 1
    source "${LIB_DIR}/configure-config.sh" || exit 1
    
    # Restore test CONFIG_FILE after sourcing (config.sh sets it to real path)
    CONFIG_DIR="${TEST_OUTPUT_DIR}"
    CONFIG_FILE="${TEST_OUTPUT_DIR}/config/sleep-warning.conf"
}

# Print test result
print_test_result() {
    local test_name="$1"
    local result="$2"
    local details="$3"
    
    TESTS_RUN=$((TESTS_RUN + 1))
    
    if [ "$result" = "PASS" ]; then
        TESTS_PASSED=$((TESTS_PASSED + 1))
        echo -e "${GREEN}✓${NC} ${test_name}"
        if [ -n "$details" ]; then
            echo -e "    ${details}"
        fi
    else
        TESTS_FAILED=$((TESTS_FAILED + 1))
        echo -e "${RED}✗${NC} ${test_name}"
        if [ -n "$details" ]; then
            echo -e "    ${YELLOW}Details: ${details}${NC}"
        fi
    fi
}

# Test 1: Verify atomic write creates temp file first
test_atomic_write_temp_file() {
    print_section "Test 1: Atomic write creates temp file first"
    
    # Use the test CONFIG_FILE already set in setup()
    # CONFIG_FILE is already set to ${TEST_OUTPUT_DIR}/config/sleep-warning.conf
    
    # Clear any existing temp files
    rm -f "${CONFIG_FILE}.tmp"* 2>/dev/null
    
    # Call write_config
    local config_lines=("SUNDAY=0-5" "MONDAY=0-5")
    write_config "10" "medium" "center" "30" "true" "false" "none" "true" "5" "24" "auto" "false" "fixed" "50%x50%" "1280x720" "${config_lines[@]}" "" "" "false" "false"
    
    # Check if config file was created
    if [ ! -f "${CONFIG_FILE}" ]; then
        print_test_result "Config file created" "FAIL" "Config file not created"
        return
    fi
    
    # Check that no temp files remain
    local temp_files
    temp_files=$(ls "${CONFIG_FILE}.tmp"* 2>/dev/null | wc -l)
    if [ "${temp_files}" -gt 0 ]; then
        print_test_result "No temp files remain after write" "FAIL" "Found ${temp_files} temp file(s) still present"
        return
    fi
    
    print_test_result "Config file created successfully" "PASS"
    print_test_result "No temp files remain (atomic write completed)" "PASS"
}

# Test 2: Verify config file content is correct
test_config_file_content() {
    print_section "Test 2: Config file content is correct"
    
    # Use the test CONFIG_FILE already set in setup()
    # CONFIG_FILE is already set to ${TEST_OUTPUT_DIR}/config/sleep-warning.conf
    
    # Call write_config
    local config_lines=("SUNDAY=0-5" "MONDAY=0-5")
    write_config "10" "medium" "center" "30" "true" "false" "none" "true" "5" "24" "auto" "false" "fixed" "50%x50%" "1280x720" "${config_lines[@]}" "" "" "false" "false"
    
    # Check if config file exists
    if [ ! -f "${CONFIG_FILE}" ]; then
        print_test_result "Config file exists" "FAIL" "Config file not created"
        return
    fi
    
    # Check for key content (Enhancement #30: wizard writes POPUP_DISPLAY_FREQUENCY)
    if grep -q "POPUP_DISPLAY_FREQUENCY=10" "${CONFIG_FILE}"; then
        print_test_result "POPUP_DISPLAY_FREQUENCY written correctly" "PASS"
    else
        print_test_result "POPUP_DISPLAY_FREQUENCY written correctly" "FAIL" "POPUP_DISPLAY_FREQUENCY not found in config file"
    fi
    
    if grep -q "POPUP_SIZE=medium" "${CONFIG_FILE}"; then
        print_test_result "POPUP_SIZE written correctly" "PASS"
    else
        print_test_result "POPUP_SIZE written correctly" "FAIL" "POPUP_SIZE not found in config file"
    fi
    
    if grep -q "SUNDAY=0-5" "${CONFIG_FILE}"; then
        print_test_result "SUNDAY restriction written correctly" "PASS"
    else
        print_test_result "SUNDAY restriction written correctly" "FAIL" "SUNDAY restriction not found in config file"
    fi
}

# Test 3: Verify original file preserved if write fails
test_original_file_preserved() {
    print_section "Test 3: Original file preserved if write fails"
    
    # Use the test CONFIG_FILE already set in setup()
    # CONFIG_FILE is already set to ${TEST_OUTPUT_DIR}/config/sleep-warning.conf
    
    # Create initial config file with known content (use POPUP_DISPLAY_FREQUENCY for consistency with Enhancement #30)
    echo "POPUP_DISPLAY_FREQUENCY=5" > "${CONFIG_FILE}"
    echo "POPUP_SIZE=small" >> "${CONFIG_FILE}"
    local original_content
    original_content=$(cat "${CONFIG_FILE}")
    
    # Make config directory read-only to simulate write failure
    chmod 555 "${CONFIG_DIR}/config" 2>/dev/null || true
    
    # Try to write config (should fail)
    local config_lines=("SUNDAY=0-5")
    write_config "10" "medium" "center" "30" "true" "false" "none" "true" "5" "24" "auto" "false" "fixed" "50%x50%" "1280x720" "${config_lines[@]}" "" "" "false" "false"
    local write_result=$?
    
    # Restore permissions
    chmod 755 "${CONFIG_DIR}/config" 2>/dev/null || true
    
    # Check if original content is preserved
    local current_content
    current_content=$(cat "${CONFIG_FILE}" 2>/dev/null || echo "")
    
    if [ "${write_result}" -ne 0 ]; then
        print_test_result "Write correctly failed when directory read-only" "PASS"
    else
        print_test_result "Write correctly failed when directory read-only" "FAIL" "Write should have failed but returned success"
    fi
    
    # Note: The original file might be modified if temp file write succeeded but move failed
    # This is acceptable - the atomic write prevents corruption, not all failures
    print_test_result "Atomic write handles errors gracefully" "PASS"
}

# Main test execution
main() {
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  Atomic Write Test${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    
    # Setup
    setup
    
    # Run tests
    test_atomic_write_temp_file
    echo ""
    test_config_file_content
    echo ""
    test_original_file_preserved
    echo ""
    
    # Print summary
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  Test Summary${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "Tests run:    ${TESTS_RUN}"
    echo -e "Tests passed: ${GREEN}${TESTS_PASSED}${NC}"
    echo -e "Tests failed: ${RED}${TESTS_FAILED}${NC}"
    echo ""
    
    # Cleanup
    cleanup
    
    # Exit with appropriate code
    if [ "${TESTS_FAILED}" -eq 0 ]; then
        echo -e "${GREEN}All tests passed!${NC}"
        exit 0
    else
        echo -e "${RED}Some tests failed!${NC}"
        exit 1
    fi
}

# Helper function to print section header
print_section() {
    local section_name="$1"
    echo -e "${BLUE}━━━ ${section_name} ━━━${NC}"
}

# Run main function
main
